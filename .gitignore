# PLAN.md and reviewer_notes.md are tracked (backup, decided 2026-11-06).
# Embargoed security notes stay local until the fix ships:
*.local.md
mnemo.tar

.DS_Store
target/
*.mnemo
# Test fixtures may be committed: synthetic data under throwaway test
# secrets only, never real memories (AGENTS.md, "Never commit").
!mnemo/tests/fixtures/**/*.mnemo
# 12.4 shared mode's sidecar directory next to a brain (lock and hint files).
*.mnemo-shared/
.env

# Dogfooding sandbox — runtime artifacts stay local; tooling is tracked
test/*
!test/README.md
!test/.env.example
!test/requirements.txt
!test/scripts/
test/.env
test/project.mnemo
test/project-memory.jsonl
test/.cache/
test/__pycache__/
test/.venv/
**/__pycache__/
